{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/build_site.py",
  "outputDirectory": "docs",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/parks/carlsbad-caverns-national-park",
      "destination": "https://www.nps.gov/media/webcam/view.htm?id=ECD2475F-95A4-43C7-9E78-DED990F833F9",
      "permanent": true
    },
    {
      "source": "/parks/carlsbad-caverns-national-park.html",
      "destination": "https://www.nps.gov/media/webcam/view.htm?id=ECD2475F-95A4-43C7-9E78-DED990F833F9",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "national-parks.us"
        }
      ],
      "destination": "https://www.national-parks.us/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/previews/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
